---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	plan(plan)
	research(research)
	synthesize(synthesize)
	review(review)
	remember(remember)
	rejected(rejected)
	__end__([<p>__end__</p>]):::last
	__start__ --> plan;
	plan -.-> research;
	research --> synthesize;
	review -.-> rejected;
	review -.-> remember;
	synthesize --> review;
	rejected --> __end__;
	remember --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

